# Private single-CPU logging trial; no storage and no peripheral feature acceptance.
CONFIG_ARCH_MEDIATEK=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_USB=y
CONFIG_USB_PHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_INVENTRA_DMA=y
CONFIG_PHY_MTK_TPHY=y
# CONFIG_USB_MUSB_HOST is not set
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_MUSB_PIO_ONLY is not set
# CONFIG_NETDEVICES is not set
# CONFIG_PCI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_VT is not set
# CONFIG_HID is not set
# CONFIG_INPUT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PWM is not set
# CONFIG_DEBUG_FS is not set
CONFIG_PERF_EVENTS=y
# PERF_EVENTS core is retained; the lab DT disables the hardware PMU.
# CONFIG_ARM_CCI_PMU is not set
# CONFIG_ARM_SDE_INTERFACE is not set
# CONFIG_ARM_SMCCC_SOC_ID is not set
# CONFIG_ARM64_RSI is not set
# CONFIG_ARM_FFA_TRANSPORT is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_DEVTMPFS is not set
# CONFIG_DEVTMPFS_MOUNT is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_FORCE_NR_CPUS is not set
CONFIG_NR_CPUS=4

# Service only an already-running firmware watchdog via the kernel core.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
# CONFIG_WATCHDOG_NOWAYOUT is not set
# CONFIG_WATCHDOG_PRETIMEOUT_GOV is not set
