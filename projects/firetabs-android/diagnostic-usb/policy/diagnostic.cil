; Isolated lab PID1 policy proposal. Not an Android/public-OS policy.
; No permissive domains, policy reload, enforcement toggle, networking or block IO.
(handleunknown deny)
(mls false)
(policycap open_perms)
(sensitivity s0)
(sensitivityorder (s0))
(user system_u)
(role system_r)
(role object_r)
(userrole system_u system_r)
(userrole system_u object_r)
(userlevel system_u (s0))
(userrange system_u ((s0) (s0)))
(type kernel_t)
(type init_t)
(type security_t)
(type unlabeled_t)
(type rootfs_t)
(type dev_dir_t)
(type kmsg_t)
(type console_t)
(type tty_t)
(type proc_t)
(type sys_t)
(type configfs_t)
(type gadget_root_t)
(type gadget_t)
(type protected_t)
(typeattribute trial_domain)
(typeattributeset trial_domain (kernel_t init_t))
(roletype system_r kernel_t)
(roletype system_r init_t)
(roletype object_r security_t)
(roletype object_r unlabeled_t)
(roletype object_r rootfs_t)
(roletype object_r dev_dir_t)
(roletype object_r kmsg_t)
(roletype object_r console_t)
(roletype object_r tty_t)
(roletype object_r proc_t)
(roletype object_r sys_t)
(roletype object_r configfs_t)
(roletype object_r gadget_root_t)
(roletype object_r gadget_t)
(roletype object_r protected_t)
; All archive paths are RAM; no block filesystem/node is admitted.
(genfscon rootfs / (system_u object_r rootfs_t ((s0) (s0))))
(genfscon rootfs /dev (system_u object_r dev_dir_t ((s0) (s0))))
(genfscon rootfs /dev/kmsg (system_u object_r kmsg_t ((s0) (s0))))
(genfscon rootfs /dev/console (system_u object_r console_t ((s0) (s0))))
(genfscon rootfs /dev/firetabs-acm (system_u object_r tty_t ((s0) (s0))))
(genfscon proc / (system_u object_r proc_t ((s0) (s0))))
(genfscon proc /sysrq-trigger (system_u object_r protected_t ((s0) (s0))))
(genfscon proc /kmsg (system_u object_r protected_t ((s0) (s0))))
(genfscon sysfs / (system_u object_r sys_t ((s0) (s0))))
(genfscon selinuxfs / (system_u object_r security_t ((s0) (s0))))
(genfscon configfs / (system_u object_r configfs_t ((s0) (s0))))
(genfscon configfs /usb_gadget (system_u object_r gadget_root_t ((s0) (s0))))
(genfscon configfs /usb_gadget/firetabs-diagnostic (system_u object_r gadget_t ((s0) (s0))))
(allow trial_domain self (capability (sys_admin mknod)))
(allow trial_domain self (capability2 (syslog)))
(allow trial_domain kernel_t (system (syslog_read)))
(allow trial_domain rootfs_t (dir (search read open getattr mounton)))
(allow trial_domain rootfs_t (file (read open getattr)))
(allow trial_domain dev_dir_t (dir (search read open getattr write add_name remove_name)))
(typetransition kernel_t dev_dir_t chr_file "firetabs-acm" tty_t)
(typetransition init_t dev_dir_t chr_file "firetabs-acm" tty_t)
(allow trial_domain kmsg_t (chr_file (open read getattr)))
(allow trial_domain console_t (chr_file (open write getattr)))
(allow trial_domain tty_t (chr_file (create open read write ioctl getattr setattr unlink)))
(allow tty_t rootfs_t (filesystem (associate)))
(allow trial_domain proc_t (dir (search read open getattr)))
(allow trial_domain proc_t (file (read open getattr)))
(allow trial_domain proc_t (lnk_file (read getattr)))
(allow trial_domain sys_t (dir (search read open getattr)))
(allow trial_domain sys_t (file (read open getattr)))
(allow trial_domain sys_t (lnk_file (read getattr)))
(allow trial_domain security_t (dir (search read open getattr)))
(allow trial_domain security_t (file (read open getattr)))
; Mount/unmount only the named virtual filesystem types; mountpoints are archive dirs.
(allow trial_domain proc_t (filesystem (mount unmount getattr)))
(allow trial_domain sys_t (filesystem (mount unmount getattr)))
(allow trial_domain security_t (filesystem (mount remount unmount getattr)))
(allow trial_domain configfs_t (filesystem (mount unmount getattr)))
(allow trial_domain configfs_t (dir (search read open getattr)))
; Parent name transition grants creation of the one owned gadget subtree.
(allow trial_domain gadget_root_t (dir (search read open getattr write add_name remove_name)))
(typetransition kernel_t gadget_root_t dir "firetabs-diagnostic" gadget_t)
(typetransition init_t gadget_root_t dir "firetabs-diagnostic" gadget_t)
(allow trial_domain gadget_t (dir (create search read open getattr write add_name remove_name rmdir)))
(allow trial_domain gadget_t (file (read write open getattr)))
(allow trial_domain gadget_t (lnk_file (create read getattr unlink)))
(allow gadget_t configfs_t (filesystem (associate)))
; These negative invariants must survive every policy compilation.
(neverallow trial_domain security_t (security (setenforce load_policy setbool)))
(neverallow trial_domain self (capability (sys_boot sys_module sys_rawio)))
(neverallow trial_domain self (capability2 (mac_admin mac_override)))
(neverallow trial_domain protected_t (file (read write open append)))

(typeattribute all_trial_types)
(typeattributeset all_trial_types (kernel_t init_t security_t unlabeled_t rootfs_t dev_dir_t kmsg_t console_t tty_t proc_t sys_t configfs_t gadget_root_t gadget_t protected_t))
(neverallow trial_domain all_trial_types (blk_file (open read write ioctl create getattr)))
