; Standalone Panfrost/DRM trial extension, not an Android production policy.
; Keep PID1 fork forbidden. Gallium/GL threading and disk shader cache are off.
(type drm_display_t)
(type drm_render_t)
(type graphics_mem_t)
(type graphics_null_t)
(type graphics_random_t)
(roletype object_r drm_display_t)
(roletype object_r drm_render_t)
(roletype object_r graphics_mem_t)
(roletype object_r graphics_null_t)
(roletype object_r graphics_random_t)
(typeattributeset all_trial_types (drm_display_t drm_render_t graphics_mem_t graphics_null_t graphics_random_t))
(typeattribute graphics_drm_types)
(typeattributeset graphics_drm_types (drm_display_t drm_render_t))
(typeattribute graphics_memory_types)
(typeattributeset graphics_memory_types (graphics_mem_t unlabeled_t))
(typeattributeset storage_types (drm_display_t drm_render_t graphics_mem_t))
(allow kernel_t graphics_drm_types (chr_file (getattr relabelto)))
(allow graphics_drm_types rootfs_t (filesystem (associate)))
(allow kernel_t graphics_null_t (chr_file (getattr relabelto)))
(allow kernel_t graphics_random_t (chr_file (getattr relabelto)))
(allow graphics_null_t rootfs_t (filesystem (associate)))
(allow graphics_random_t rootfs_t (filesystem (associate)))
(allow init_t graphics_null_t (chr_file (open read write getattr)))
(allow init_t graphics_random_t (chr_file (open read getattr)))
(allow init_t graphics_drm_types (chr_file (open read write getattr ioctl map)))
(allow init_t rootfs_t (file (execute execute_no_trans map)))
(allow init_t rootfs_t (lnk_file (read getattr)))
; GEM shmem and dma-buf internal files, not writable archive paths.
(genfscon tmpfs / (system_u object_r graphics_mem_t ((s0) (s0))))
(genfscon dmabuf / (system_u object_r graphics_mem_t ((s0) (s0))))
(allow graphics_mem_t graphics_mem_t (filesystem (associate)))
(allow init_t graphics_memory_types (file (open read write getattr map ioctl setattr)))
(allow init_t graphics_memory_types (anon_inode (open read write getattr map ioctl)))
(allow init_t self (anon_inode (open read write getattr map ioctl)))
(neverallow init_t graphics_memory_types (file (execute execute_no_trans execmod)))
(neverallow init_t graphics_memory_types (anon_inode (execute execmod)))
(neverallow init_t graphics_drm_types (chr_file (create setattr unlink relabelfrom relabelto)))
(neverallow trial_domain graphics_drm_types (blk_file (open read write append ioctl create getattr relabelfrom relabelto)))
